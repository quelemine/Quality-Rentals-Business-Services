# Uploads directory — serve images only, never execute code
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .asp .aspx .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8

<IfModule mod_authz_core.c>
  # Allow static files, deny executable/script types
  <FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|asp|aspx|sh|exe)$">
    Require all denied
  </FilesMatch>
</IfModule>
